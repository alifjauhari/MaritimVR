  entries:
  - speakerName: Virtual Assistant
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 710b882700796044ea18028e5e363f7a, type: 3}
    sections:
    - text: 'Reporting and procedures

        1. Follow procedures : Always follow
        the safety training and established procedures. Never disable safety guards
        or take shortcuts.'
      startTime: 0
      duration: 13
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: '2. Report hazards : Immediate report any unsafe conditions, damaged
        equipment, or hazardous situations to your supervisorpas'
      startTime: 13
      duration: 11
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: '3. Report Accidents : Report all accidents and near-miss events, no
        matter how minor, to help prevent future incidents'
      startTime: 24
      duration: 10
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: '4. Know emergency procedures : Familiarize yourself with emergency exits,
        evacuation plans, and other emergency procedures for your workplace'
      startTime: 34
      duration: 10
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  isFromStart: 1
  hidePanelOnEnd: 1
  defaultTextOnlyDuration: 3
