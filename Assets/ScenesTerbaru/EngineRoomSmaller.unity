  nextButton: {fileID: 1889749396}
  layoutRoot: {fileID: 280662144}
  onEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1777245275}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
