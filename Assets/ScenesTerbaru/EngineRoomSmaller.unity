          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  entries:
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: a4937904a29ef1c4fb066ca58b12d3c2, type: 3}
    sections:
    - text: "I\u2019d like to walk through our vessel\u2019s fuel monitoring setup
        to ensure alignment on each component\u2019s function, data reliability,
        and Understanding. "
      startTime: 0
      duration: 9
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: "I\u2019ll explain each system briefly and would appreciate your feedback
        on operational accuracy and any improvement suggestions"
      startTime: 9
      duration: 8
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: bdca1655de1baa541b022033ca1d0cd2, type: 3}
    sections:
    - text: "Let\u2019s start by walking through each TransTRACK unit. I\u2019ll
        explain its data flow, integration point, and how it supports our fuel and
        engine monitoring. "
      startTime: 0
      duration: 9
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: If there are any crew concerns or access issues, we can address them
        here.
      startTime: 9
      duration: 4
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 1b7f14be1c338b04bb7445358050b324, type: 3}
    sections:
    - text: "Currently, we estimate AE consumption via panel tapping. I\u2019ll show
        you the tapping point and explain how we corelate it with runtime and load."
      startTime: 0
      duration: 9
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 32048452d6f1a74488f715977504816f, type: 3}
    sections:
    - text: "We\u2019ve installed Coriolis flow meters on the main engine fuel line.
        These provide real-time mass flow data."
      startTime: 0
      duration: 7
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 6788d46534e4d55488bfbc3de7e0b2d0, type: 3}
    sections:
    - text: "We\u2019re using RPM sensors to correlate engine speed with fuel consumption."
      startTime: 0
      duration: 5
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 0ff70d070b22ae14ba752130b8dd3bdd, type: 3}
    sections:
    - text: Fuel Level to monitor the fuel level in the daily tank, it makes it easier
        for crew to read the total volume remaining in the daily tank without having
        to do manual sounding and convert it to a sounding table.
      startTime: 0
      duration: 13
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 0ff70d070b22ae14ba752130b8dd3bdd, type: 3}
    sections:
    - text: "I\u2019ll compile your feedback and update our system documentation
        and crew training materials accordingly. Your insights are critical for ensuring
        operational reliability and compliance."
      startTime: 0
      duration: 12
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  isFromStart: 0
  hidePanelOnEnd: 1
  defaultTextOnlyDuration: 3
