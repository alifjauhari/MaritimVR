  entries:
  - speakerName: TransTRACKER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: efd397ad01aed3b4db51b4164874372d, type: 3}
    sections:
    - text: "Hello Captain, Nice to meet you\nThank you again, Captain. I appreciate
        the opportunity to visit MT TransTRACK 06. Before we begin the tour, could
        you share a bit more about the vessel\u2019s recent operations?"
      startTime: 0
      duration: 13
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: Captain
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 59031d2fa5561604db57d874607df751, type: 3}
    sections:
    - text: "Certainly, TransTRACK. We\u2019ve just completed a coastal bunkering
        run from Balikpapan to Batam. The vessel performed well"
      startTime: 0
      duration: 7
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: "fuel consumption was within expected range based on Fuel Consumption
        Monitoring, and our monitoring system logged consistent RPM and flow data.
        We\u2019re currently preparing for a short layup for minor maintenance."
      startTime: 7
      duration: 13
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1512198555}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
          m_MethodName: Play
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Talking
            m_BoolArgument: 0
          m_CallState: 2
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: TransTRACKER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: a72e3840657513244ab43b9aabe6ef0e, type: 3}
    sections:
    - text: "Sounds like a smooth run. How\u2019s the crew holding up?"
      startTime: 0
      duration: 4
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: Captain
    dialogueText: 
    audioClip: {fileID: 8300000, guid: ec2a7071768ba734d8deded788a0ff33, type: 3}
    sections:
    - text: "They\u2019re in good spirits. We\u2019ve had a stable rotation schedule,
        and the last safety drill went well. The Chief Engineer is reviewing engine
        performance logs, and the deck team is prepping for hull cleaning during
        layup."
      startTime: 0
      duration: 13
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1512198555}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
          m_MethodName: Play
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Talking
            m_BoolArgument: 0
          m_CallState: 2
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: TransTRACKER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 9ad20f8b31b79d24393e7c5ebd851f2e, type: 3}
    sections:
    - text: "Excellent. I\u2019d like to start the tour with the engine room, then
        move to the bridge, and finish at the top deck. I\u2019ll follow all safety
        protocols and wear PPE throughout."
      startTime: 0
      duration: 11
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: Captain
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 5b4493eac3b427048a63f95e67b0af0a, type: 3}
    sections:
    - text: "Perfect. I\u2019ll assign the Chief Officer to guide you. The engine
        room is fully operational\u2014watch your step near the auxiliary units."
      startTime: 0
      duration: 8
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: "On the bridge, you\u2019ll see our integrated navigation suite and compliance
        dashboard. The top deck offers a clear view of our manifold arrangement and
        safety zones."
      startTime: 8
      duration: 11
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1512198555}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
          m_MethodName: Play
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Talking
            m_BoolArgument: 0
          m_CallState: 2
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: TransTRACKER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 7fb0141d045a1e945bef5b7610958e4d, type: 3}
    sections:
    - text: "Appreciate the briefing. I\u2019ll document key observations for our
        technical team and flag anything that may need follow-up."
      startTime: 0
      duration: 8
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls: []
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: Captain
    dialogueText: 
    audioClip: {fileID: 8300000, guid: 3ee2c80dd7318c341b51b4b3ae1af43e, type: 3}
    sections:
    - text: "Good initiative. Let me know if you need access to any logs or system
        readouts. We\u2019re happy to support."
      startTime: 0
      duration: 7
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1512198555}
          m_TargetAssemblyTypeName: UnityEngine.Animator, UnityEngine
          m_MethodName: Play
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Talking
            m_BoolArgument: 0
          m_CallState: 2
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  isFromStart: 0
  hidePanelOnEnd: 1
  defaultTextOnlyDuration: 3
  holdToEndTime: 2
