  entries:
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: a4937904a29ef1c4fb066ca58b12d3c2, type: 3}
    sections:
    - text: "I\u2019d like to walk through our vessel\u2019s fuel monitoring setup
        to ensure alignment on each component\u2019s function, data reliability,
        and Understanding. "
      startTime: 0
      duration: 9
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: "I\u2019ll explain each system briefly and would appreciate your feedback
        on operational accuracy and any improvement suggestions"
      startTime: 9
      duration: 8
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    onEntryStart:
