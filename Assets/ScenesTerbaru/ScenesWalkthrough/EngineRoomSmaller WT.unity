            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Talking
            m_BoolArgument: 0
          m_CallState: 2
    onEntryComplete:
      m_PersistentCalls:
        m_Calls: []
  - speakerName: CHIEF OFFICER
    dialogueText: 
    audioClip: {fileID: 8300000, guid: bdca1655de1baa541b022033ca1d0cd2, type: 3}
    sections:
    - text: "Let\u2019s start by walking through each TransTRACK unit. I\u2019ll
        explain its data flow, integration point, and how it supports our fuel and
        engine monitoring. "
      startTime: 0
      duration: 9
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
    - text: If there are any crew concerns or access issues, we can address them
        here.
      startTime: 9
      duration: 4
      onSectionStart:
        m_PersistentCalls:
          m_Calls: []
      onSectionComplete:
        m_PersistentCalls:
          m_Calls: []
